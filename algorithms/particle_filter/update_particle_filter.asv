% function [public_vars] = update_particle_filter(read_only_vars, public_vars)
%     particles = public_vars.particles;
%     N = public_vars.particles_count;
% 
%     % I. Prediction
%     for i=1:N
%         particles(i, 1:3) = predict_pose(particles(i, 1:3), public_vars.motion_vector, read_only_vars, public_vars.motion_noise);
%     end
% 
%     % II. Correction
%     measurements = zeros(N, length(read_only_vars.lidar_config));
%     for i=1:N
%         measurements(i, :) = compute_lidar_measurement(read_only_vars.map, particles(i, 1:3), ...
%             read_only_vars.lidar_config, public_vars.lidar_range);
%     end
% 
%     raw_weights = weight_particles(measurements, read_only_vars.lidar_distances, public_vars);
%     avg_raw_weight = mean(raw_weights);
% 
%     % --- ПОЛНАЯ ПОТЕРЯ ЛОКАЛИЗАЦИИ: реинициализация ---
%     panic_threshold = 1e-12;
%     if avg_raw_weight < panic_threshold
%         disp('КРИТИЧЕСКАЯ ПОТЕРЯ ЛОКАЛИЗАЦИИ! Полный перезапуск фильтра...');
%         public_vars = init_particle_filter(read_only_vars, public_vars);
%         return;
%     end
%     % ---------------------------------------------------
% 
%     % Нормализация весов
%     sum_w = sum(raw_weights);
%     if sum_w > 0
%         public_vars.weights = raw_weights / sum_w;
%     else
%         public_vars.weights = ones(N, 1) / N;
%     end
% 
%     % III. Clustering & Resampling
%     Neff = 1 / sum(public_vars.weights .^ 2);
% 
%     if Neff < N * 0.5
%         cluster_ids = cluster_particles(particles(:, 1:3), 0.9, 6);
%         particles(:, 4) = cluster_ids;
% 
%         valid_clusters = unique(cluster_ids(cluster_ids > 0));
%         num_clusters = length(valid_clusters);
% 
%         new_particles = zeros(N, 4);
% 
%         if num_clusters > 0
%             % Считаем суммарный вес каждого кластера
%             cluster_total_weights = zeros(num_clusters, 1);
%             for k = 1:num_clusters
%                 cluster_mask = (particles(:, 4) == valid_clusters(k));
%                 cluster_total_weights(k) = sum(public_vars.weights(cluster_mask));
%             end
% 
%             % Отсеиваем слабые кластеры (< 5% суммарного веса)
%             threshold = 0.05 * sum(cluster_total_weights);
%             valid_clusters = valid_clusters(cluster_total_weights > threshold);
%             num_clusters = length(valid_clusters);
%         end
% 
%         if num_clusters > 0
%             particles_per_cluster = floor(N / num_clusters);
%             idx_start = 1;
% 
%             for k = 1:num_clusters
%                 c_id = valid_clusters(k);
%                 cluster_mask = (particles(:, 4) == c_id);
%                 c_particles = particles(cluster_mask, :);
%                 c_weights = public_vars.weights(cluster_mask);
% 
%                 sum_c_w = sum(c_weights);
%                 if sum_c_w > 0
%                     c_weights = c_weights / sum_c_w;
%                 else
%                     c_weights = ones(size(c_weights)) / length(c_weights);
%                 end
% 
%                 c_resampled = resample_particles(c_particles, c_weights, particles_per_cluster);
%                 idx_end = idx_start + particles_per_cluster - 1;
%                 new_particles(idx_start:idx_end, :) = c_resampled;
%                 idx_start = idx_end + 1;
%             end
% 
%             % Добиваем остаток копией последней частицы (если N не делится ровно)
%             if idx_start <= N
%                 new_particles(idx_start:N, :) = repmat(new_particles(idx_start-1, :), N - idx_start + 1, 1);
%             end
%         else
%             % Все кластеры слабые — обычный глобальный ресемплинг
%             new_particles(:, 1:3) = resample_particles(particles(:, 1:3), public_vars.weights, N);
%         end
% 
%         public_vars.weights = ones(N, 1) / N;
%         public_vars.particles = new_particles;
%     else
%         public_vars.particles = particles;
%     end
% end

% function [public_vars] = update_particle_filter(read_only_vars, public_vars)
%     particles = public_vars.particles;
%     N = public_vars.particles_count;
% 
%     % I. Prediction
%     for i=1:N
%         particles(i, 1:3) = predict_pose(particles(i, 1:3), public_vars.motion_vector, read_only_vars, public_vars.motion_noise);
%     end
% 
%     % II. Correction
%     measurements = zeros(N, length(read_only_vars.lidar_config));
%     for i=1:N
%         measurements(i, :) = compute_lidar_measurement(read_only_vars.map, particles(i, 1:3), ...
%             read_only_vars.lidar_config, public_vars.lidar_range);
%     end
% 
%     % Получаем СЫРЫЕ веса
%     raw_weights = weight_particles(measurements, read_only_vars.lidar_distances, public_vars);
% 
%     % --- ДЕТЕКТОР ПОТЕРИ ЛОКАЛИЗАЦИИ (AMCL) ---
%     avg_raw_weight = mean(raw_weights);
% 
%     % Коэффициенты скорости реакции (можно вынести в public_vars)
%     alpha_slow = 0.001; 
%     alpha_fast = 0.1;
% 
%     % Инициализация при первом запуске
%     if public_vars.w_slow == 0
%         public_vars.w_slow = avg_raw_weight;
%         public_vars.w_fast = avg_raw_weight;
%     end
% 
%     % Обновление экспоненциальных средних
%     public_vars.w_slow = public_vars.w_slow + alpha_slow * (avg_raw_weight - public_vars.w_slow);
%     public_vars.w_fast = public_vars.w_fast + alpha_fast * (avg_raw_weight - public_vars.w_fast);
% 
%     % Вычисляем долю инъекции случайных частиц (от 0.0 до 1.0)
%     p_inject = max(0.0, 1.0 - (public_vars.w_fast / max(public_vars.w_slow, 1e-10)));
% 
%     % Глобальная нормализация весов (необходима для Neff и ресемплинга)
%     sum_w = sum(raw_weights);
%     if sum_w > 0
%         public_vars.weights = raw_weights / sum_w;
%     else
%         public_vars.weights = ones(N, 1) / N;
%     end
%     % ------------------------------------------
% 
%     % III. Clustering & Isolated Resampling
%     Neff = 1 / sum(public_vars.weights .^ 2);
% 
%     % Форсируем ресемплинг, если Neff упал ИЛИ если фильтр требует инъекции
%     if Neff < N * 0.5 || p_inject > 0.05
%         cluster_ids = cluster_particles(particles(:, 1:3), 0.9, 6); 
%         particles(:, 4) = cluster_ids;
% 
%         valid_clusters = unique(cluster_ids(cluster_ids > 0));
%         num_clusters = length(valid_clusters);
% 
%         new_particles = zeros(N, 4);
% 
%         % Считаем, сколько частиц сохранить, а сколько вбросить случайно
%         num_inject = floor(N * p_inject);
%         num_keep = N - num_inject;
% 
%         % 1. Распределяем выжившие частицы по кластерам (если есть что сохранять)
%         if num_keep > 0
%             if num_clusters > 0
%                 cluster_total_weights = zeros(num_clusters, 1);
%                 for k = 1:num_clusters
%                     cluster_mask = (particles(:, 4) == valid_clusters(k));
%                     cluster_total_weights(k) = sum(public_vars.weights(cluster_mask));
%                 end
% 
%                 threshold = 0.05 * sum(cluster_total_weights);
%                 valid_clusters = valid_clusters(cluster_total_weights > threshold);
%                 num_clusters = length(valid_clusters);
% 
%                 if num_clusters > 0
%                     particles_per_cluster = floor(num_keep / num_clusters);
%                     idx_start = 1;
% 
%                     for k = 1:num_clusters
%                         c_id = valid_clusters(k);
%                         cluster_mask = (particles(:, 4) == c_id);
%                         c_particles = particles(cluster_mask, :);
%                         c_weights = public_vars.weights(cluster_mask);
% 
%                         sum_c_w = sum(c_weights);
%                         if sum_c_w > 0
%                             c_weights = c_weights / sum_c_w;
%                         else
%                             c_weights = ones(size(c_weights)) / length(c_weights);
%                         end
% 
%                         c_resampled = resample_particles(c_particles, c_weights, particles_per_cluster);
%                         idx_end = idx_start + particles_per_cluster - 1;
%                         new_particles(idx_start:idx_end, :) = c_resampled;
%                         idx_start = idx_end + 1;
%                     end
% 
%                     if idx_start <= num_keep
%                         new_particles(idx_start:num_keep, :) = repmat(new_particles(idx_start-1, :), num_keep - idx_start + 1, 1);
%                     end
%                 else
%                     new_particles(1:num_keep, 1:3) = resample_particles(particles(:, 1:3), public_vars.weights, num_keep);
%                 end
%             else
%                 new_particles(1:num_keep, 1:3) = resample_particles(particles(:, 1:3), public_vars.weights, num_keep);
%             end
%         end
% 
%         % 2. --- ДИНАМИЧЕСКАЯ ИНЪЕКЦИЯ СЛУЧАЙНЫХ ЧАСТИЦ ---
%         if num_inject > 0
%             x_min = read_only_vars.map.limits(1) + 0.8;
%             y_min = read_only_vars.map.limits(2) + 0.8;
%             x_max = read_only_vars.map.limits(3) - 0.8;
%             y_max = read_only_vars.map.limits(4) - 0.8;
% 
%             dilated_grid = dilate_map(read_only_vars.discrete_map.map);
%             valid_inj = 0;
%             inj_idx = num_keep + 1; % Начинаем писать после сохраненных частиц
% 
%             while valid_inj < num_inject
%                 rand_x = x_min + (x_max - x_min) * rand();
%                 rand_y = y_min + (y_max - y_min) * rand();
% 
%                 % Генерируем только в свободном пространстве
%                 if is_free_space([rand_x, rand_y], read_only_vars, dilated_grid, 25)
%                     new_particles(inj_idx, 1) = rand_x;
%                     new_particles(inj_idx, 2) = rand_y;
%                     new_particles(inj_idx, 3) = -pi + 2 * pi * rand();
%                     new_particles(inj_idx, 4) = 0; % ID = 0 (пока не в кластере)
%                     valid_inj = valid_inj + 1;
%                     inj_idx = inj_idx + 1;
%                 end
%             end
%         end
%         % ------------------------------------------------
% 
%         public_vars.weights = ones(N, 1) / N;
%         public_vars.particles = new_particles;
%     else
%         public_vars.particles = particles;
%     end
% end